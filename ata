def cmd_uninstall(args: argparse.Namespace) -> int:
    if not args.yes:
        if not ask_bool("Remove ata services from this machine?", False):
            info("cancelled")
            return 0
    with contextlib.suppress(Exception):
        cmd_down(argparse.Namespace(quiet=True))
    if args.delete_shares and zrok_bin().exists() and zrok_env_enabled():
        cfg = load_config(required=False)
        for name, svc in (cfg_services(cfg) if cfg else []):
            with contextlib.suppress(Exception):
                run_cmd([str(zrok_bin()), "delete", "share", str(svc["share"])], timeout=30)
        ok("reserved zrok shares deleted")
    if systemd_available():
        for unit in unit_dir().glob("ata-*.service"):
            with contextlib.suppress(Exception):
                systemctl_user("disable", "--now", unit.name)
            with contextlib.suppress(FileNotFoundError):
                unit.unlink()
        with contextlib.suppress(Exception):
            systemctl_user("daemon-reload")
    cron_remove_autostart()
    if args.purge:
        for path in (config_dir(), state_dir(), data_dir()):
            with contextlib.suppress(FileNotFoundError):
                shutil.rmtree(path)
        ok("configuration, state, and binaries removed")
    else:
        ok("services removed; configuration and key kept")
    if args.purge_zrok:
        if zrok_bin().exists():
            with contextlib.suppress(Exception):
                run_cmd([str(zrok_bin()), "disable"], timeout=30)
        with contextlib.suppress(FileNotFoundError):
            shutil.rmtree(base_home() / ".zrok2")
        ok("local zrok environment removed")
    return 0


