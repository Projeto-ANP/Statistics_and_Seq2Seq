def ask_text(
    label: str,
    default: Optional[str] = None,
    secret: bool = False,
    allow_empty: bool = False,
) -> str:
    suffix = f" [{default}]" if default not in (None, "") else ""
    prompt = f"{label}{suffix}: "
    while True:
        try:
            value = getpass.getpass(prompt) if secret else input(prompt)
        except EOFError as exc:
            raise AtaError("input closed") from exc
        value = value.strip()
        if value:
            return value
        if allow_empty:
            return ""
        if default is not None:
            return str(default)
        eprint("  value required.")


def ask_bool(label: str, default: bool = True) -> bool:
    suffix = "Y/n" if default else "y/N"
    while True:
        try:
            value = input(f"{label} [{suffix}]: ").strip().lower()
        except EOFError as exc:
            raise AtaError("input closed") from exc
        if not value:
            return default
        if value in ("s", "sim", "y", "yes", "1"):
            return True
        if value in ("n", "nao", "não", "no", "0"):
            return False
        eprint("  answer y or n.")


def ask_int(label: str, default: int) -> int:
    while True:
        raw = ask_text(label, str(default))
        try:
            value = int(raw)
        except ValueError:
            eprint("  enter a number.")
            continue
        if 1 <= value <= 65535:
            return value
        eprint("  invalid port (1-65535).")


