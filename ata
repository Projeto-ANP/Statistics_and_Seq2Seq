def gateway_spec(cfg: Dict[str, Any], service: str = "ollama") -> ProcSpec:
    key = "server-gateway" if service == "ollama" else f"server-gateway-{service}"
    return ProcSpec(
        key=key,
        description=f"ata gateway for {service}",
        argv=[
            sys.executable,
            str(script_path()),
            "--config",
            str(config_path()),
            "gateway",
            "--service",
            service,
        ],
        log_name=key,
    )


def server_specs(cfg: Dict[str, Any]) -> List[ProcSpec]:
    specs: List[ProcSpec] = []
    for service, _svc in ollama_services(cfg):
        specs.append(gateway_spec(cfg, service))
    for name, svc in cfg_services(cfg):
        target = service_target(svc)
        specs.append(
            ProcSpec(
                key=f"server-share-{name}",
                description=f"ata zrok share {name}",
                argv=share_argv(str(svc["share"]), target),
                log_name=f"server-share-{name}",
            )
        )
    return specs


def client_specs(cfg: Dict[str, Any]) -> List[ProcSpec]:
    specs: List[ProcSpec] = []
    for name, svc in cfg_services(cfg):
        bind = f"127.0.0.1:{service_client_port(svc)}"
        specs.append(
            ProcSpec(
                key=f"client-access-{name}",
                description=f"ata zrok access {name}",
                argv=access_argv(str(svc["share"]), bind),
                log_name=f"client-access-{name}",
            )
        )
    return specs


def spec_for_key(cfg: Dict[str, Any], key: str) -> Optional[ProcSpec]:
    all_specs = server_specs(cfg) + client_specs(cfg)
    for spec in all_specs:
        if spec.key == key or spec.key.endswith(f"-{key}"):
            return spec
    return None


