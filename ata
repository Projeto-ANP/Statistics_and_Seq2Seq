    return 0


def cmd_logs(args: argparse.Namespace) -> int:
    cfg = load_config()
    role = cfg["role"]
    service = args.service or ("gateway" if role == "server" else "ollama")
    if service == "audit":
        paths = sorted(logs_dir().glob("*-gateway.jsonl"))
        if not paths:
            raise AtaError(f"audit log does not exist yet in {logs_dir()}")
        cmd = ["tail", "-n", str(args.lines)]
        if args.follow:
            cmd.append("-f")
        cmd.extend(str(path) for path in paths)
        return subprocess.call(cmd)
    aliases = {
        "gateway": "server-gateway",
        "ollama": f"{'server-share' if role == 'server' else 'client-access'}-ollama",
        "code": f"{'server-share' if role == 'server' else 'client-access'}-code",
        "ssh": f"{'server-share' if role == 'server' else 'client-access'}-ssh",
        "guacamole": f"{'server-share' if role == 'server' else 'client-access'}-guacamole",
    }
    key = aliases.get(service, service)
    if service.startswith("gateway-"):
        key = f"server-{service}"
    spec = spec_for_key(cfg, key)
    if not spec:
        raise AtaError(f"unknown service: {service}")
    supervisor = cfg.get("runtime", {}).get("active_supervisor") or cfg.get("runtime", {}).get("supervisor", "auto")
    if supervisor == "auto":
        supervisor = "systemd" if systemd_available() else "nohup"
    if supervisor == "systemd" and systemd_available() and shutil.which("journalctl"):
        cmd = ["journalctl", "--user", "-u", spec.unit, "-n", str(args.lines), "--no-pager"]
        if args.follow:
            cmd.append("-f")
        return subprocess.call(cmd, env=systemd_env())
    path = spec.log_path
    if not path.exists():
        raise AtaError(f"log does not exist yet: {path}")
    cmd = ["tail", "-n", str(args.lines)]
    if args.follow:
        cmd.append("-f")
    cmd.append(str(path))
    return subprocess.call(cmd)


