def deep_fill(defaults: Dict[str, Any], value: Dict[str, Any]) -> Dict[str, Any]:
    out = dict(value)
    for key, default in defaults.items():
        if key not in out:
            out[key] = default
        elif isinstance(default, dict) and isinstance(out.get(key), dict):
            out[key] = deep_fill(default, out[key])
    return out


def load_config(required: bool = True) -> Dict[str, Any]:
    path = config_path()
    if not path.exists():
        if required:
            raise AtaError(f"configuration missing at {path}; run: {script_path()} init")
        return {}
    cfg = read_json(path)
    role = cfg.get("role")
    if role not in ("server", "client"):
        raise AtaError("invalid configuration: role must be 'server' or 'client'")
    prefix = sanitize_prefix(str(cfg.get("prefix") or default_prefix()))
    cfg["prefix"] = prefix
    cfg = deep_fill(default_config(role, prefix), cfg)
    secrets_cfg = cfg.setdefault("secrets", {})
    key_map = secrets_cfg.setdefault("ollama_keys", {})
    legacy_key = secrets_cfg.get("ollama_key_file")
    if legacy_key:
        key_map.setdefault("ollama", str(legacy_key))

    # Ensure every service has a valid share token (max 32 chars in zrok).
    for index, (name, svc) in enumerate(cfg["services"].items()):
        current = str(svc.get("share") or "")
        if not valid_share_token(current):
            svc["share"] = share_name(prefix, name)
        svc["enabled"] = bool(svc.get("enabled"))
        svc.setdefault("label", SERVICE_DEFS.get(name, {}).get("label", name))
        svc["upstream_port"] = int(svc.get("upstream_port", SERVICE_DEFS.get(name, {}).get("upstream_port", 0)))
        svc["client_port"] = int(svc.get("client_port", SERVICE_DEFS.get(name, {}).get("client_port", 0)))
        if svc.get("auth") == "bearer":
            svc.setdefault("label", "Ollama" if name == "ollama" else name)
            svc.setdefault(
                "env_prefix",
                "OLLAMA" if name == "ollama" else "OLLAMA_" + re.sub(r"[^A-Za-z0-9]+", "_", name).upper(),
            )
            svc.setdefault("gateway_port", 18080 + index)
            svc["gateway_port"] = int(svc["gateway_port"])
            if not svc["client_port"]:
                svc["client_port"] = int(svc["gateway_port"])
            key_map.setdefault(name, str(key_path(name)))
        elif svc.get("kind") == "http" and "gateway_port" in svc:
            svc["gateway_port"] = int(svc["gateway_port"])
    if key_map:
        secrets_cfg.setdefault("ollama_key_file", key_map.get("ollama", str(key_path())))
    return cfg


def save_config(cfg: Dict[str, Any]) -> None:
    cfg["ata_version"] = VERSION
    cfg["updated_at"] = now_iso()
    write_json(config_path(), cfg)
    ensure_secure_file(config_path())


def cfg_services(cfg: Dict[str, Any], enabled_only: bool = True) -> List[Tuple[str, Dict[str, Any]]]:
    items = []
    for name, svc in cfg.get("services", {}).items():
        if enabled_only and not svc.get("enabled"):
            continue
        items.append((name, svc))
    # bearer/Ollama gateways first, then other HTTP, then TCP
    def sort_key(item: Tuple[str, Dict[str, Any]]) -> Tuple[int, str]:
        name, svc = item
        if svc.get("auth") == "bearer":
            return (0, name)
        if svc.get("kind") == "http":
            return (1, name)
        return (2, name)
    return sorted(items, key=sort_key)


def ollama_services(cfg: Dict[str, Any], enabled_only: bool = True) -> List[Tuple[str, Dict[str, Any]]]:
    items = [
        (name, svc)
        for name, svc in cfg.get("services", {}).items()
        if svc.get("auth") == "bearer" and (not enabled_only or svc.get("enabled"))
    ]
    return sorted(items, key=lambda item: (item[0] != "ollama", item[0]))


def service_label(name: str, svc: Dict[str, Any]) -> str:
    return str(
        svc.get("label")
        or SERVICE_DEFS.get(name, {}).get("label")
        or ("Ollama" if name == "ollama" else name)
    )


def service_env_prefix(name: str, svc: Dict[str, Any]) -> str:
    if svc.get("env_prefix"):
        return str(svc["env_prefix"])
    return "OLLAMA" if name == "ollama" else "OLLAMA_" + re.sub(r"[^A-Za-z0-9]+", "_", name).upper()


def service_upstream(svc: Dict[str, Any]) -> str:
