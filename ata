def _arch() -> str:
    machine = platform.machine().lower()
    if machine in ("x86_64", "amd64"):
        return "amd64"
    if machine in ("aarch64", "arm64"):
        return "arm64"
    if machine.startswith("armv7") or machine == "armv7l":
        return "armv7"
    raise AtaError(f"architecture not supported by zrok2: {machine}")


def _platform_asset() -> str:
    system = platform.system().lower()
    if system == "linux":
        return "linux"
    if system == "darwin":
        return "darwin"
    raise AtaError("unsupported OS; use Linux, macOS, or WSL")


def _github_json(url: str) -> Dict[str, Any]:
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": f"{APP}/{VERSION}",
            "Accept": "application/vnd.github+json",
        },
    )
    with urllib.request.urlopen(req, timeout=25) as resp:
        return json.loads(resp.read().decode("utf-8"))


def _download(url: str, dest: Path, timeout: int = 180) -> None:
    req = urllib.request.Request(url, headers={"User-Agent": f"{APP}/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout) as resp, dest.open("wb") as fh:
        shutil.copyfileobj(resp, fh, length=1024 * 256)


def install_zrok2(version: str = "latest", force: bool = False) -> Path:
    target = zrok_bin()
    if target.exists() and not force:
        probe = run_cmd([str(target), "version"], timeout=15)
        if probe.returncode == 0:
            return target

    ensure_dir(bin_dir(), 0o700)
    arch = _arch()
    osname = _platform_asset()
    tag = ""
    tarball_url = ""
    checksums_url = ""

    if version and version != "latest":
        tag = version if version.startswith("v") else f"v{version}"
    else:
        try:
            release = _github_json(GITHUB_RELEASES_API)
            tag = release.get("tag_name", "")
            for asset in release.get("assets", []):
                name = asset.get("name", "")
                if name == f"zrok_{tag.lstrip('v')}_{osname}_{arch}.tar.gz":
                    tarball_url = asset.get("browser_download_url", "")
                elif name == "checksums.sha256.txt":
                    checksums_url = asset.get("browser_download_url", "")
        except Exception as exc:  # network / API rate limit
            warn(f"could not query GitHub ({exc}); using zrok2 {DEFAULT_ZROK_VERSION}")
            tag = f"v{DEFAULT_ZROK_VERSION}"

    if not tag:
        tag = f"v{DEFAULT_ZROK_VERSION}"
    ver = tag.lstrip("v")
    if not tarball_url:
        tarball_url = f"https://github.com/openziti/zrok/releases/download/{tag}/zrok_{ver}_{osname}_{arch}.tar.gz"
    if not checksums_url:
        checksums_url = f"https://github.com/openziti/zrok/releases/download/{tag}/checksums.sha256.txt"

    info(f"downloading zrok2 {tag} ({osname}/{arch})...")
    with tempfile.TemporaryDirectory(prefix="ata-zrok-") as tmpdir:
        tmp = Path(tmpdir)
        tarball = tmp / f"zrok_{ver}_{osname}_{arch}.tar.gz"
        checksums = tmp / "checksums.sha256.txt"
        try:
            _download(tarball_url, tarball)
            _download(checksums_url, checksums)
        except Exception as exc:
            raise AtaError(f"failed to download zrok2: {exc}") from exc

        expected = None
        for line in checksums.read_text(encoding="utf-8", errors="replace").splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[-1] == tarball.name:
                expected = parts[0].lower()
                break
        if not expected:
            raise AtaError(f"checksum not found for {tarball.name}")
        actual = hashlib.sha256(tarball.read_bytes()).hexdigest()
        if not hmac.compare_digest(actual, expected):
            raise AtaError("zrok2 checksum mismatch; download aborted")

        with tarfile.open(tarball, "r:gz") as tf:
            member = None
            for m in tf.getmembers():
                if m.isfile() and m.name.endswith("/zrok2") or m.isfile() and m.name == "zrok2":
                    member = m
                    break
            if member is None:
                raise AtaError("zrok2 binary not found in package")
            extracted = tf.extractfile(member)
            if extracted is None:
                raise AtaError("failed to extract zrok2")
            fd, tmpbin = tempfile.mkstemp(prefix=".zrok2.", dir=str(bin_dir()))
            try:
                os.fchmod(fd, 0o700)
                with os.fdopen(fd, "wb") as out:
                    shutil.copyfileobj(extracted, out, length=1024 * 256)
                os.replace(tmpbin, target)
            finally:
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(tmpbin)
    ensure_secure_file(target)
    with contextlib.suppress(OSError):
        os.chmod(target, 0o700)
    if platform.system().lower() == "darwin" and shutil.which("xattr"):
        with contextlib.suppress(Exception):
            run_cmd(["xattr", "-d", "com.apple.quarantine", str(target)], timeout=15)

    proc = run_cmd([str(target), "version"], timeout=20)
    if proc.returncode != 0:
        raise AtaError(f"zrok2 downloaded but does not run: {(proc.stderr or proc.stdout).strip()}")
    ok(f"zrok2 installed at {target} ({strip_ansi(proc.stdout).strip().splitlines()[-1]})")
    return target


def ensure_zrok2(cfg: Dict[str, Any], force: bool = False) -> Path:
    if zrok_bin().exists() and not force:
        probe = run_cmd([str(zrok_bin()), "version"], timeout=15)
        if probe.returncode == 0:
            return zrok_bin()
    version = str(cfg.get("runtime", {}).get("zrok_version", "latest") or "latest")
    return install_zrok2(version=version, force=force)


def zrok_status_text() -> str:
    if not zrok_bin().exists():
        return ""
    proc = run_cmd([str(zrok_bin()), "status"], timeout=30)
    return strip_ansi((proc.stdout or "") + (proc.stderr or ""))


def zrok_env_enabled() -> bool:
    text = zrok_status_text()
    if not text:
        return False
    if "To create a local environment" in text:
        return False
    return "EnvZId" in text and "<<SET>>" in text


def ensure_zrok_enabled(token: Optional[str] = None) -> None:
    if zrok_env_enabled():
        return
    install_zrok2()
    if not token:
        token = os.environ.get("ZROK_ACCOUNT_TOKEN", "").strip()
    if not token:
        eprint("")
        eprint("You need a free account at https://myzrok.io")
        eprint("In the dashboard, click 'CLICK HERE TO GET STARTED' and copy the account token.")
        eprint("The token is a secret: it identifies your account and all its devices.")
        token = ask_text("Account token do zrok", secret=True)
    if not re.fullmatch(r"[A-Za-z0-9_-]{8,128}", token):
        raise AtaError("unexpected zrok account token format")
    info("enabling the zrok2 environment (once per device)...")
    proc = run_cmd(
        [str(zrok_bin()), "enable", "--headless", token],
        timeout=120,
    )
    if proc.returncode != 0:
        detail = strip_ansi((proc.stderr or proc.stdout or "").strip())
        detail = detail.replace(token, "***")
        raise AtaError(f"zrok2 enable failed: {detail}")
    if not zrok_env_enabled():
        raise AtaError("zrok2 enable finished, but the environment is not active")
    zrok_root = base_home() / ".zrok2"
    with contextlib.suppress(OSError):
        os.chmod(zrok_root, 0o700)
    ok("zrok2 environment enabled")


def zrok_share_info(name: str) -> Optional[Dict[str, Any]]:
    if not zrok_env_enabled():
        return None
    proc = run_cmd(
        [str(zrok_bin()), "list", "shares", "--json", "--share-token", name],
        timeout=45,
    )
    if proc.returncode != 0:
        return None
    raw = strip_ansi(proc.stdout or "").strip()
    if raw:
        try:
            data = json.loads(raw)
            for share in data.get("shares", []):
                if isinstance(share, dict) and share.get("shareToken") == name:
                    return share
        except json.JSONDecodeError:
            pass
    # Fallback for versions that do not support --json.
    text = strip_ansi((proc.stdout or "") + (proc.stderr or ""))
    low = text.lower()
    if (
        "not found" not in low
        and "error" not in low
        and re.search(rf"(?<![A-Za-z0-9_-]){re.escape(name)}(?![A-Za-z0-9_-])", text)
    ):
        return {"shareToken": name}
    return None


def zrok_share_exists(name: str) -> bool:
    return zrok_share_info(name) is not None


def ensure_share(name: str, backend_mode: str) -> None:
    existing = zrok_share_info(name)
    if existing:
        current_mode = str(existing.get("backendMode") or "")
        if current_mode and current_mode != backend_mode:
            raise AtaError(
                f"share '{name}' already exists with backend mode '{current_mode}', "
                f"but the configuration expects '{backend_mode}'; delete that share or use another prefix"
            )
        return
    info(f"creating private share '{name}' ({backend_mode})...")
    proc = run_cmd(
        [
            str(zrok_bin()),
            "create",
            "share",
            "--backend-mode",
            backend_mode,
            "--share-token",
            name,
        ],
        timeout=60,
    )
    if proc.returncode != 0:
        text = strip_ansi((proc.stdout or "") + (proc.stderr or "")).lower()
        # Idempotencia: alguns servidores retornam conflito se o token ja existe.
        if not any(s in text for s in ("already", "exists", "conflict", "duplicate", "in use")):
            detail = strip_ansi((proc.stderr or proc.stdout or "").strip())
            raise AtaError(f"could not create share '{name}': {detail}")
    for _ in range(3):
        if zrok_share_exists(name):
            return
        time.sleep(0.5)
    # Nao falha aqui: o share private ainda pode funcionar; o status mostrara.
    warn(f"share '{name}' did not appear in the listing; trying to start it anyway")


def share_argv(name: str, target: str) -> List[str]:
    # Quando --share-token e usado, o zrok2 usa o backend-mode gravado no
    # share reservado e recusa --backend-mode no mesmo comando.
    return [
        str(zrok_bin()),
        "share",
        "private",
        "--headless",
        "--force-local",
        "--share-token",
        name,
        target,
    ]


def access_argv(name: str, bind: str) -> List[str]:
    return [
        str(zrok_bin()),
        "access",
        "private",
        "--headless",
        "--force-local",
        "--bind",
        bind,
        name,
    ]


# ---------------------------------------------------------------------------
# Supervisor: systemd --user or nohup
# ---------------------------------------------------------------------------

@dataclass
class ProcSpec:
    key: str
    description: str
    argv: List[str]
    log_name: str

    @property
    def unit(self) -> str:
        return f"ata-{self.key}.service"

    @property
    def log_path(self) -> Path:
        return logs_dir() / f"{self.key}.log"

    @property
    def pid_path(self) -> Path:
        return state_dir() / "run" / f"{self.key}.pid"


def systemd_available() -> bool:
    if not shutil.which("systemctl"):
        return False
    proc = run_cmd(
        ["systemctl", "--user", "show-environment"],
        env=systemd_env(),
        timeout=15,
    )
    return proc.returncode == 0


def linger_enabled() -> Optional[bool]:
    if not shutil.which("loginctl"):
        return None
    user = getpass.getuser()
    proc = run_cmd(
        ["loginctl", "show-user", user, "-p", "Linger"],
        env=systemd_env(),
        timeout=15,
    )
    if proc.returncode != 0:
        return None
    text = (proc.stdout or "").strip()
    if "Linger=yes" in text:
        return True
    if "Linger=no" in text:
        return False
    return None


def try_enable_linger() -> bool:
    if linger_enabled() is True:
        return True
    if not shutil.which("loginctl"):
        return False
    user = getpass.getuser()
    info("trying to enable linger so user services survive logout...")
    proc = run_cmd(
        ["loginctl", "enable-linger", user],
        env=systemd_env(),
        timeout=30,
    )
    if proc.returncode == 0 and linger_enabled() is True:
        return True
    detail = strip_ansi((proc.stderr or proc.stdout or "").strip())
    if detail:
        warn(f"could not enable linger: {detail}")
    return False


def choose_supervisor(requested: str = "auto") -> str:
    requested = (requested or "auto").lower()
    if requested not in ("auto", "systemd", "nohup"):
        raise AtaError("invalid supervisor; use auto, systemd, or nohup")
    if requested == "nohup":
        return "nohup"
    if requested == "systemd":
        if not systemd_available():
            raise AtaError("systemd --user is not available in this session")
        if os.environ.get("ATA_HOME"):
            raise AtaError("--home is not compatible with systemd --user; use --supervisor nohup")
        return "systemd"
    # auto
    if os.environ.get("ATA_HOME"):
        return "nohup"
    if not systemd_available():
        return "nohup"
    linger = linger_enabled()
    if linger is True:
        return "systemd"
    if linger is False and try_enable_linger():
        return "systemd"
    if linger is None:
        # Sem loginctl: systemd pode funcionar, mas pode morrer no logout.
        warn("could not check linger; using nohup to survive logout")
    else:
        warn("linger is disabled; using nohup + @reboot to survive logout")
    return "nohup"


def cron_lines() -> List[str]:
    if not shutil.which("crontab"):
        return []
    proc = run_cmd(["crontab", "-l"], timeout=15)
    if proc.returncode != 0:
        return []
    return proc.stdout.splitlines()


def cron_write(lines: List[str]) -> bool:
    if not shutil.which("crontab"):
        return False
    text = "\n".join(lines).rstrip("\n") + "\n"
    proc = run_cmd(["crontab", "-"], input_text=text, timeout=20)
    return proc.returncode == 0


def cron_install_autostart() -> None:
    if os.environ.get("ATA_NO_CRON") == "1":
        return
    if not shutil.which("crontab"):
        warn("crontab not found; the tunnel will not restart automatically after reboot")
        return
    global_args: List[str] = []
    if os.environ.get("ATA_HOME"):
        global_args += ["--home", os.environ["ATA_HOME"]]
    if os.environ.get("ATA_CONFIG"):
        global_args += ["--config", os.environ["ATA_CONFIG"]]
    log = state_dir() / "cron.log"
    ensure_dir(log.parent, 0o700)
    line = (
        f"@reboot umask 077 && {shlex.quote(sys.executable)} {shlex.quote(str(script_path()))} "
        + (" ".join(shlex.quote(a) for a in global_args) + " " if global_args else "")
        + f"up --quiet --supervisor nohup >> {shlex.quote(str(log))} 2>&1 {CRON_MARKER}"
    )
    lines = [ln for ln in cron_lines() if CRON_MARKER not in ln]
    lines.append(line)
    if cron_write(lines):
        ok("@reboot autostart installed in the user crontab")
    else:
        warn("could not install the @reboot entry in the crontab")


def cron_remove_autostart() -> None:
    if os.environ.get("ATA_NO_CRON") == "1":
        return
    if not shutil.which("crontab"):
        return
    lines = cron_lines()
    new = [ln for ln in lines if CRON_MARKER not in ln]
    if len(new) != len(lines):
        with contextlib.suppress(Exception):
            cron_write(new)


def systemd_quote(arg: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9_@%+=:,./-]+", arg):
        return arg
    return '"' + arg.replace("\\", "\\\\").replace('"', '\\"') + '"'


def write_unit(spec: ProcSpec) -> Path:
    ensure_dir(unit_dir(), 0o755)
    exec_start = " ".join(systemd_quote(a) for a in spec.argv)
    unit = f"""[Unit]
Description={spec.description}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart={exec_start}
WorkingDirectory={systemd_quote(str(config_dir()))}
Environment=HOME={systemd_quote(str(base_home()))}
Environment=PYTHONUNBUFFERED=1
Environment=NO_COLOR=1
Environment=ZROK2_HEADLESS=1
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
"""
    path = unit_dir() / spec.unit
    atomic_write(path, unit, 0o644)
    return path


def systemctl_user(*args: str, check: bool = False) -> subprocess.CompletedProcess:
    return run_cmd(
        ["systemctl", "--user", *args],
        env=systemd_env(),
        timeout=60,
        check=check,
    )


def start_systemd(spec: ProcSpec) -> None:
    write_unit(spec)
    systemctl_user("daemon-reload")
    systemctl_user("reset-failed", spec.unit)
    proc = systemctl_user("enable", "--now", spec.unit)
    if proc.returncode != 0:
        detail = strip_ansi((proc.stderr or proc.stdout or "").strip())
        raise AtaError(f"could not start {spec.unit}: {detail}")


def stop_systemd(spec: ProcSpec) -> None:
    if not systemd_available():
        return
    with contextlib.suppress(Exception):
        systemctl_user("disable", "--now", spec.unit)


def systemd_active(spec: ProcSpec) -> bool:
    if not systemd_available():
        return False
    proc = systemctl_user("is-active", spec.unit)
    return (proc.stdout or "").strip() == "active"


def pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def read_pid(spec: ProcSpec) -> int:
    try:
        return int(spec.pid_path.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, ValueError):
        return 0


def pid_matches(spec: ProcSpec, pid: int) -> bool:
    """True only if the PID belongs to this ata process (avoids stale PID reuse)."""
    if not pid_alive(pid):
        return False
    environ_path = Path(f"/proc/{pid}/environ")
    if environ_path.exists():
        try:
            entries = environ_path.read_bytes().split(b"\0")
            return f"ATA_PROC_KEY={spec.key}".encode() in entries
        except OSError:
            return False
    # macOS/BSD fallback: there is no /proc. `ps eww` includes the environment.
    if shutil.which("ps"):
        proc = run_cmd(["ps", "eww", "-p", str(pid), "-o", "command="], timeout=5)
        command = proc.stdout or ""
        if f"ATA_PROC_KEY={spec.key}" in command:
            return True
        return spec.argv[0] in command and spec.argv[-1] in command
    return True


def rotate_log(path: Path, max_mb: int) -> None:
    with contextlib.suppress(OSError):
        if path.exists() and path.stat().st_size > max_mb * 1024 * 1024:
            backup = path.with_suffix(path.suffix + ".1")
            with contextlib.suppress(FileNotFoundError):
                backup.unlink()
            path.rename(backup)


def start_nohup(spec: ProcSpec) -> None:
    old_pid = read_pid(spec)
    if pid_matches(spec, old_pid):
        return
    with contextlib.suppress(FileNotFoundError):
        spec.pid_path.unlink()
    ensure_dir(logs_dir(), 0o700)
    ensure_dir(spec.pid_path.parent, 0o700)
    rotate_log(spec.log_path, 5)
    with spec.log_path.open("ab") as log:
        ensure_secure_file(spec.log_path)
        proc = subprocess.Popen(
            spec.argv,
            stdout=log,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
            env=app_env({"ATA_PROC_KEY": spec.key}),
            cwd=str(config_dir()),
        )
    spec.pid_path.write_text(str(proc.pid), encoding="utf-8")
    ensure_secure_file(spec.pid_path)
    time.sleep(0.8)
    if proc.poll() is not None:
        tail = ""
        with contextlib.suppress(Exception):
            tail = "\n".join(spec.log_path.read_text(encoding="utf-8", errors="replace").splitlines()[-15:])
        raise AtaError(f"{spec.key} exited right after starting.\n{tail}")


def stop_nohup(spec: ProcSpec) -> None:
    pid = read_pid(spec)
    if pid_matches(spec, pid):
        try:
            os.killpg(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            with contextlib.suppress(ProcessLookupError):
                os.kill(pid, signal.SIGTERM)
        deadline = time.time() + 8
        while time.time() < deadline and pid_alive(pid):
            time.sleep(0.2)
        if pid_alive(pid):
            try:
                os.killpg(pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                with contextlib.suppress(ProcessLookupError):
                    os.kill(pid, signal.SIGKILL)
    with contextlib.suppress(FileNotFoundError):
        spec.pid_path.unlink()


def spec_running(spec: ProcSpec, supervisor: str) -> bool:
    if supervisor == "systemd":
        return systemd_active(spec)
    return pid_matches(spec, read_pid(spec))


def start_specs(specs: List[ProcSpec], supervisor: str) -> None:
    if not specs:
        return
    # Avoid duplicate processes when switching between systemd and nohup.
    for spec in specs:
        if supervisor == "systemd":
            stop_nohup(spec)
        else:
            stop_systemd(spec)
    if supervisor == "systemd":
        for spec in specs:
            info(f"starting {spec.key}...")
            start_systemd(spec)
            time.sleep(0.4)
    else:
        for spec in specs:
            info(f"starting {spec.key}...")
            start_nohup(spec)
            time.sleep(0.4)


def stop_specs(specs: List[ProcSpec]) -> None:
    # Try both systemd and nohup; one of them is harmless.
    for spec in specs:
        stop_systemd(spec)
        stop_nohup(spec)


