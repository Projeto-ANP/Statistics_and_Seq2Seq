def app_env(extra: Optional[Dict[str, str]] = None) -> Dict[str, str]:
    env = os.environ.copy()
    # ATA_HOME isola tudo (inclusive ~/.zrok2) durante testes.
    if os.environ.get("ATA_HOME"):
        env["HOME"] = os.environ["ATA_HOME"]
    env["ZROK2_HEADLESS"] = "1"
    env["NO_COLOR"] = "1"
    env["TERM"] = "dumb"
    env.setdefault("PYTHONUNBUFFERED", "1")
    if extra:
        env.update(extra)
    return env


def systemd_env() -> Dict[str, str]:
    env = app_env()
    if not env.get("XDG_RUNTIME_DIR"):
        candidate = Path(f"/run/user/{os.getuid()}")
        if candidate.is_dir():
            env["XDG_RUNTIME_DIR"] = str(candidate)
    if os.environ.get("ATA_HOME"):
        env["XDG_CONFIG_HOME"] = str(base_home() / ".config")
    return env


def ensure_dir(path: Path, mode: int = 0o700) -> Path:
    path.mkdir(parents=True, exist_ok=True)
    with contextlib.suppress(OSError):
        os.chmod(path, mode)
    return path


def ensure_secure_file(path: Path) -> None:
    with contextlib.suppress(OSError):
        os.chmod(path, 0o600)


def atomic_write(path: Path, data: str, mode: int = 0o600) -> None:
    ensure_dir(path.parent, 0o700)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)


def read_json(path: Path) -> Dict[str, Any]:
    try:
        with path.open("r", encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError as exc:
        raise AtaError(f"file not found: {path}") from exc
    except json.JSONDecodeError as exc:
        raise AtaError(f"invalid JSON in {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise AtaError(f"{path} does not contain a JSON object")
    return data


def write_json(path: Path, data: Dict[str, Any]) -> None:
    atomic_write(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n", 0o600)


def run_cmd(
    argv: List[str],
    *,
    check: bool = False,
    timeout: int = 120,
    env: Optional[Dict[str, str]] = None,
    cwd: Optional[Path] = None,
    input_text: Optional[str] = None,
) -> subprocess.CompletedProcess:
    try:
        proc = subprocess.run(
            argv,
            input=input_text,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=env or app_env(),
            cwd=str(cwd) if cwd else None,
        )
    except FileNotFoundError as exc:
        raise AtaError(f"command not found: {argv[0]}") from exc
    except subprocess.TimeoutExpired as exc:
        raise AtaError(f"timed out running {argv[0]}") from exc
    if check and proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        raise AtaError(f"{argv[0]} failed (code {proc.returncode}): {detail}")
    return proc


def strip_ansi(text: str) -> str:
    return re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", text)


def require_cmd(name: str) -> str:
    found = shutil.which(name)
    if not found:
        raise AtaError(f"required command not found: {name}")
    return found


def sanitize_prefix(value: str) -> str:
    value = value.strip().lower()
    value = re.sub(r"[^a-z0-9-]+", "-", value)
    value = re.sub(r"-{2,}", "-", value).strip("-")
    if not value:
        raise AtaError("invalid prefix")
    if len(value) > 48:
        value = value[:48].rstrip("-")
    return value


def share_name(prefix: str, service: str) -> str:
    """Token de share do zrok: minusculas, digitos e '-', no maximo 32 chars."""
    base = sanitize_prefix(prefix)
    direct = f"{base}-{service}"
    if valid_share_token(direct):
        return direct
    slug = base[:10].rstrip("-")
    digest = hashlib.sha256(base.encode("utf-8")).hexdigest()[:6]
    name = f"{slug}-{digest}-{service}"
    if len(name) > 32:
        name = name[:32].rstrip("-")
    return name


def valid_share_token(value: str) -> bool:
    return re.fullmatch(r"[a-z0-9-]{3,32}", value or "") is not None


def default_prefix() -> str:
    host = socket.gethostname().split(".")[0]
    return sanitize_prefix(f"ata-{host}")


def hostname_short() -> str:
    return socket.gethostname().split(".")[0]


def human_bytes(n: int) -> str:
    units = ["B", "KiB", "MiB", "GiB"]
    value = float(n)
    for unit in units:
        if value < 1024 or unit == units[-1]:
            return f"{value:.1f} {unit}" if unit != "B" else f"{int(value)} B"
        value /= 1024
    return f"{n} B"


