def cmd_key(args: argparse.Namespace) -> int:
    cfg = load_config()
    if cfg["role"] != "server":
        raise AtaError("the key command only applies to the server")
    all_services = [service for service, _svc in ollama_services(cfg)]
    if args.service:
        if args.service not in all_services:
            raise AtaError(f"unknown Ollama service: {args.service}")
        services = [args.service]
    else:
        services = all_services
    if not services:
        raise AtaError("no Ollama services are enabled")
    if args.key_command == "show":
        if len(services) == 1:
            print(read_ollama_key(cfg, services[0]))
        else:
            for service in services:
                label = service_label(service, cfg["services"][service])
                print(f"{label} ({service}): {read_ollama_key(cfg, service)}")
        return 0
    if args.key_command == "rotate":
        sup = cfg.get("runtime", {}).get("active_supervisor") or cfg.get("runtime", {}).get("supervisor", "auto")
        if sup == "auto":
            sup = "systemd" if systemd_available() else "nohup"
        restart = False
        for service in services:
            with contextlib.suppress(Exception):
                read_ollama_key(cfg, service)
            new = generate_ollama_key(cfg, service)
            key_file = ollama_key_file(cfg, service)
            ensure_secure_file(key_file)
            ok(f"new key for '{service}' generated at {key_file}")
            if spec_running(gateway_spec(cfg, service), sup):
                restart = True
            if len(services) == 1:
                print(new)
        save_config(cfg)
        if restart:
            info("restarting services so the gateways pick up the new key")
            with contextlib.suppress(Exception):
                cmd_restart(argparse.Namespace(quiet=True, supervisor=None))
        if len(services) > 1:
            for service in services:
                label = service_label(service, cfg["services"][service])
                print(f"{label} ({service}): {read_ollama_key(cfg, service)}")
        return 0
    raise AtaError("use: ata key show|rotate")


def build_bundle(cfg: Dict[str, Any]) -> Dict[str, Any]:
    bundle: Dict[str, Any] = {
        "ata_bundle": 1,
        "created_at": now_iso(),
        "prefix": cfg["prefix"],
        "server_hostname": cfg.get("hostname", hostname_short()),
        "services": {},
    }
    for name, svc in cfg_services(cfg):
        bundle["services"][name] = {
            "enabled": True,
            "kind": svc.get("kind"),
            "auth": svc.get("auth"),
            "label": service_label(name, svc),
            "env_prefix": service_env_prefix(name, svc),
            "share": svc["share"],
            "client_port": service_client_port(svc),
            "description": svc.get("description", name),
        }
    keys: Dict[str, str] = {}
    for service, _svc in ollama_services(cfg):
        keys[service] = read_ollama_key(cfg, service)
    if keys:
        bundle["ollama_keys"] = keys
        if "ollama" in keys:
            bundle["ollama_key"] = keys["ollama"]  # backward compatibility
    return bundle


def load_bundle(path: Path) -> Dict[str, Any]:
    try:
        if str(path) == "-":
            data = json.load(sys.stdin)
        else:
            data = read_json(path)
    except json.JSONDecodeError as exc:
        raise AtaError(f"invalid bundle: {exc}") from exc
    if data.get("ata_bundle") != 1:
        raise AtaError("file does not look like an ata bundle (missing ata_bundle field)")
    return data


def apply_bundle(cfg: Dict[str, Any], bundle: Dict[str, Any]) -> None:
    cfg["role"] = "client"
    cfg.setdefault("runtime", {})["active_supervisor"] = ""
    cfg["prefix"] = sanitize_prefix(str(bundle.get("prefix", cfg["prefix"])))
    cfg["hostname"] = bundle.get("server_hostname", cfg.get("hostname", ""))
    services = bundle.get("services", {})

    # The server may expose services this client does not know yet (e.g. ollama2).
    for name, incoming in services.items():
        if name in cfg["services"]:
            continue
        auth = str(incoming.get("auth") or ("bearer" if "ollama" in name else "app"))
        client_port = int(incoming.get("client_port", 0))
        cfg["services"][name] = {
            "enabled": True,
            "kind": incoming.get("kind", "http"),
            "upstream_host": "127.0.0.1",
            "upstream_port": 0,
            "client_port": client_port,
            "auth": auth,
            "label": incoming.get("label", name),
            "env_prefix": incoming.get("env_prefix", f"OLLAMA_{name.upper()}"),
            "share": incoming.get("share", share_name(cfg["prefix"], name)),
            "description": incoming.get("description", name),
        }
        if auth == "bearer":
            cfg["services"][name]["gateway_port"] = client_port or 18080

    for name, svc in cfg["services"].items():
        incoming = services.get(name)
        if not incoming:
            svc["enabled"] = False
            svc["share"] = share_name(cfg["prefix"], name)
            continue
        svc["enabled"] = bool(incoming.get("enabled", True))
        svc["share"] = str(incoming.get("share", share_name(cfg["prefix"], name)))
        svc["client_port"] = int(incoming.get("client_port", svc.get("client_port", 0)))
        svc["kind"] = incoming.get("kind", svc.get("kind", "http"))
        svc["description"] = incoming.get("description", svc.get("description", name))
        if incoming.get("auth"):
            svc["auth"] = incoming["auth"]
        if incoming.get("label"):
            svc["label"] = incoming["label"]
        if incoming.get("env_prefix"):
            svc["env_prefix"] = incoming["env_prefix"]

    keys = dict(bundle.get("ollama_keys") or {})
    if bundle.get("ollama_key") and "ollama" not in keys:
        keys["ollama"] = bundle["ollama_key"]
    key_map = cfg.setdefault("secrets", {}).setdefault("ollama_keys", {})
    for service, key in keys.items():
        path = ollama_key_file(cfg, service)
        atomic_write(path, str(key).strip() + "\n", 0o600)
        key_map[service] = str(path)
        if service == "ollama":
            cfg["secrets"]["ollama_key_file"] = str(path)


def cmd_export(args: argparse.Namespace) -> int:
    cfg = load_config()
    if cfg["role"] != "server":
        raise AtaError("export only applies to the server")
    bundle = build_bundle(cfg)
    text = json.dumps(bundle, indent=2, ensure_ascii=False) + "\n"
    if args.file:
        path = Path(args.file).expanduser()
        atomic_write(path, text, 0o600)
        eprint("")
        warn(f"bundle written to {path} (0600). It contains the Ollama key(s); treat it as a secret.")
        return 0
    warn("the bundle below contains the Ollama key(s); do not paste it into public chat/logs")
    print(text, end="")
    return 0


def cmd_import(args: argparse.Namespace) -> int:
