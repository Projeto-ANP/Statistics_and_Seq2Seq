# Ollama HTTP gateway
# ---------------------------------------------------------------------------

GATEWAY_GET_PATHS = {
    "/api/tags",
    "/api/version",
    "/api/ps",
    "/v1/models",
}
GATEWAY_POST_PATHS = {
    "/api/show",
    "/api/chat",
    "/api/generate",
    "/api/embed",
    "/api/embeddings",
    "/v1/chat/completions",
    "/v1/completions",
    "/v1/embeddings",
    "/v1/responses",
    "/v1/messages",
}
MODEL_MANAGEMENT_PREFIXES = (
    "/api/pull",
    "/api/push",
    "/api/create",
    "/api/copy",
    "/api/delete",
    "/api/blobs/",
)


class GatewayError(AtaError):
    def __init__(self, status: int, message: str) -> None:
        super().__init__(message)
        self.status = status


class GatewayHandler(http.server.BaseHTTPRequestHandler):
    server_version = f"{APP}-gateway/{VERSION}"
    sys_version = ""
    protocol_version = "HTTP/1.1"
    timeout = 600

    # Silencia o log padrao; usamos JSONL proprio.
    def log_message(self, fmt: str, *args: Any) -> None:
        return

    def setup(self) -> None:
        super().setup()
        with contextlib.suppress(OSError):
            self.connection.settimeout(self.timeout)

    # -- helpers ---------------------------------------------------------
    @property
    def gw(self) -> "GatewayServer":
        return self.server  # type: ignore[return-value]

    def _send_json(self, status: int, obj: Dict[str, Any], extra: Optional[Dict[str, str]] = None) -> None:
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)
            self.wfile.flush()

    def _auth_ok(self) -> bool:
        key = self.gw.api_key
        if not key:
            return False
        header = self.headers.get("Authorization", "")
        if header.startswith("Bearer "):
            if hmac.compare_digest(header[7:].strip(), key):
                return True
        xkey = self.headers.get("X-API-Key", "")
        if xkey and hmac.compare_digest(xkey.strip(), key):
            return True
        return False

    def _log(self, status: int, started: float, sent: int) -> None:
        path = urllib.parse.urlsplit(self.path).path
        client = self.headers.get("X-Forwarded-For") or self.headers.get("X-Real-IP") or self.client_address[0]
        rec = {
            "ts": now_iso(),
            "client": client.split(",")[0].strip()[:80],
            "method": self.command,
            "path": path[:200],
            "status": status,
            "ms": int((time.time() - started) * 1000),
            "bytes": sent,
        }
        self.gw.log_record(rec)

    def _read_body(self) -> bytes:
        max_bytes = self.gw.max_body_bytes
        length_header = self.headers.get("Content-Length")
        transfer_encoding = (self.headers.get("Transfer-Encoding") or "").lower()
        if "chunked" in transfer_encoding:
            chunks: List[bytes] = []
            total = 0
            while True:
                line = self.rfile.readline(128)
                if not line:
                    raise AtaError("truncated chunked body")
                try:
                    size = int(line.split(b";", 1)[0].strip(), 16)
                except ValueError as exc:
                    raise AtaError("invalid chunked body") from exc
                if size == 0:
                    # consome trailers
                    while True:
                        trailer = self.rfile.readline(1024)
                        if trailer in (b"\r\n", b"\n", b""):
                            break
                    break
                total += size
                if total > max_bytes:
                    raise GatewayError(413, "request body too large")
                chunks.append(self.rfile.read(size))
                self.rfile.read(2)  # CRLF
            return b"".join(chunks)
        if length_header:
            try:
                length = int(length_header)
            except ValueError as exc:
                raise AtaError("invalid Content-Length") from exc
            if length < 0 or length > max_bytes:
                raise GatewayError(413, "request body too large")
            return self.rfile.read(length) if length else b""
        return b""

    def _allowed(self, method: str, path: str) -> bool:
        if method in ("GET", "HEAD"):
            if path in GATEWAY_GET_PATHS or path.startswith("/v1/models/"):
                return True
            if self.gw.allow_model_management and path.startswith("/api/blobs/"):
                return True
            return False
        if method == "POST":
            if path in GATEWAY_POST_PATHS:
                return True
            if self.gw.allow_model_management and path.startswith(MODEL_MANAGEMENT_PREFIXES):
                return True
            return False
        return False

    def _handle(self) -> None:
        started = time.time()
        sent = 0
        status = 500
        acquired = False
        self._response_started = False
        parsed = urllib.parse.urlsplit(self.path)
        path = parsed.path
        try:
            if path == "/healthz":
                self._send_json(200, {"ok": True, "service": "ata-gateway", "version": VERSION})
                status = 200
                return

            # Defesa contra path traversal e variantes codificadas.
            if (
                "\\" in path
                or "//" in path
                or any(seg in ("..", ".") for seg in path.split("/"))
                or "%2e" in path.lower()
                or "%2f" in path.lower()
            ):
                self._send_json(404, {"error": "not_found"})
                status = 404
                return

            if not self._auth_ok():
                self._send_json(
                    401,
                    {"error": "unauthorized", "message": "send Authorization: Bearer <key>"},
                    {"WWW-Authenticate": 'Bearer realm="ata-gateway"'},
                )
                status = 401
                return

            if not self._allowed(self.command, path):
                self._send_json(404, {"error": "not_found"})
                status = 404
                return

            if not self.gw.semaphore.acquire(timeout=30):
                self._send_json(429, {"error": "busy", "message": "too many concurrent requests"})
                status = 429
                return
            acquired = True

            body = self._read_body()
            upstream_path = path + (f"?{parsed.query}" if parsed.query else "")
            status, sent = self._proxy(upstream_path, body)
        except GatewayError as exc:
            if status == 500 and not self._response_started:
                self._send_json(exc.status, {"error": "gateway_error", "message": str(exc)})
            status = exc.status
        except AtaError as exc:
            if status == 500 and not self._response_started:
                self._send_json(400, {"error": "bad_request", "message": str(exc)})
            status = 400
        except (BrokenPipeError, ConnectionResetError):
            status = 499
        except Exception as exc:  # noqa: BLE001 - boundary de servidor
            with contextlib.suppress(Exception):
                self._send_json(502, {"error": "gateway_error", "message": str(exc)[:200]})
            status = 502
        finally:
            if acquired:
                with contextlib.suppress(ValueError):
                    self.gw.semaphore.release()
            self._log(status, started, sent)

    def _proxy(self, path: str, body: bytes) -> Tuple[int, int]:
        host = self.gw.upstream_host
        port = self.gw.upstream_port
        conn = http.client.HTTPConnection(host, port, timeout=600)
        headers: Dict[str, str] = {}
        for name, value in self.headers.items():
            low = name.lower()
            if low in (
                "host",
                "authorization",
                "x-api-key",
                "connection",
                "proxy-connection",
                "keep-alive",
                "transfer-encoding",
                "content-length",
                "accept-encoding",
                "te",
                "trailer",
                "upgrade",
            ):
                continue
            headers[name] = value
        headers["Host"] = f"{host}:{port}"
        if body:
            headers["Content-Length"] = str(len(body))
        try:
            conn.request(self.command, path, body=body if body else None, headers=headers)
            resp = conn.getresponse()
        except Exception as exc:
            conn.close()
            raise GatewayError(502, f"upstream unavailable: {exc}") from exc

        status = resp.status
        self._response_started = True
        resp_headers = resp.getheaders()
        content_length = None
        for name, value in resp_headers:
            if name.lower() == "content-length":
                with contextlib.suppress(ValueError):
                    content_length = int(value)
                break

        self.send_response(status)
        for name, value in resp_headers:
            low = name.lower()
            if low in (
                "connection",
                "keep-alive",
                "proxy-authenticate",
                "proxy-authorization",
                "te",
                "trailer",
                "transfer-encoding",
                "upgrade",
                "content-length",
                "server",
                "date",
            ):
                continue
            self.send_header(name, value)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Cache-Control", "no-store")

        chunked = content_length is None
        if chunked:
            self.send_header("Transfer-Encoding", "chunked")
        else:
            self.send_header("Content-Length", str(content_length))
        self.end_headers()

        sent = 0
        if self.command == "HEAD":
            conn.close()
            return status, 0
        try:
            while True:
                chunk = resp.read(64 * 1024)
                if not chunk:
                    break
                if chunked:
                    self.wfile.write(f"{len(chunk):X}\r\n".encode("ascii"))
                    self.wfile.write(chunk)
                    self.wfile.write(b"\r\n")
                else:
                    self.wfile.write(chunk)
                self.wfile.flush()
                sent += len(chunk)
            if chunked:
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()
        finally:
            conn.close()
        return status, sent

    # -- HTTP methods ----------------------------------------------------
    def do_GET(self) -> None:
        self._handle()

    def do_HEAD(self) -> None:
        self._handle()

    def do_POST(self) -> None:
        self._handle()

    def do_OPTIONS(self) -> None:
        self.send_response(204)
        self.send_header("Allow", "GET, HEAD, POST, OPTIONS")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_PUT(self) -> None:
        self._send_json(405, {"error": "method_not_allowed"})

    def do_DELETE(self) -> None:
        self._send_json(405, {"error": "method_not_allowed"})

    def do_PATCH(self) -> None:
        self._send_json(405, {"error": "method_not_allowed"})


class GatewayServer(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(
        self,
        address: Tuple[str, int],
        *,
        upstream_host: str,
        upstream_port: int,
        api_key: str,
        max_body_bytes: int,
        max_concurrent: int,
        allow_model_management: bool,
        log_path: Path,
    ) -> None:
        self.upstream_host = upstream_host
        self.upstream_port = upstream_port
        self.api_key = api_key
        self.max_body_bytes = max_body_bytes
        self.semaphore = threading.BoundedSemaphore(max(1, max_concurrent))
        self.allow_model_management = allow_model_management
        self.log_path = log_path
        self._log_lock = threading.Lock()
        super().__init__(address, GatewayHandler)

    def handle_error(self, request: Any, client_address: Any) -> None:
        exc_type = sys.exc_info()[0]
        if exc_type in (ConnectionResetError, BrokenPipeError):
            return
        super().handle_error(request, client_address)

    def log_record(self, rec: Dict[str, Any]) -> None:
        line = json.dumps(rec, ensure_ascii=False) + "\n"
        with self._log_lock:
            try:
                ensure_dir(self.log_path.parent, 0o700)
                if self.log_path.exists() and self.log_path.stat().st_size > 5 * 1024 * 1024:
                    backup = self.log_path.with_suffix(".log.1")
                    with contextlib.suppress(FileNotFoundError):
                        backup.unlink()
                    self.log_path.rename(backup)
                with self.log_path.open("a", encoding="utf-8") as fh:
                    fh.write(line)
                ensure_secure_file(self.log_path)
            except OSError:
                pass


def ollama_key_file(cfg: Dict[str, Any], service: str = "ollama") -> Path:
    keys = cfg.get("secrets", {}).get("ollama_keys", {})
    raw = keys.get(service)
    if not raw and service == "ollama":
        raw = cfg.get("secrets", {}).get("ollama_key_file")
    return Path(raw or str(key_path(service))).expanduser()


def read_ollama_key(cfg: Dict[str, Any], service: str = "ollama") -> str:
    path = ollama_key_file(cfg, service)
    try:
        key = path.read_text(encoding="utf-8").strip()
    except FileNotFoundError as exc:
        raise AtaError(
            f"key for '{service}' not found at {path}; run: {script_path()} key rotate --service {service}"
        ) from exc
    if len(key) < 24:
        raise AtaError(f"key for '{service}' too short at {path}; run: {script_path()} key rotate --service {service}")
    ensure_secure_file(path)
    return key


def generate_ollama_key(cfg: Dict[str, Any], service: str = "ollama") -> str:
    path = ollama_key_file(cfg, service)
    key = secrets.token_hex(32)
    atomic_write(path, key + "\n", 0o600)
    keys = cfg.setdefault("secrets", {}).setdefault("ollama_keys", {})
    keys[service] = str(path)
    if service == "ollama":
        cfg["secrets"]["ollama_key_file"] = str(path)
    return key


def cmd_gateway(args: argparse.Namespace) -> int:
    cfg = load_config()
    service = args.service or "ollama"
    svc = cfg["services"].get(service, {})
    if not svc or svc.get("auth") != "bearer":
        raise AtaError(f"service '{service}' is not an Ollama gateway")
    if not svc.get("enabled"):
        raise AtaError(f"service '{service}' is disabled in the configuration")
    key = read_ollama_key(cfg, service)
    listen_port = int(args.listen_port or svc.get("gateway_port", 18080))
    upstream = args.upstream or service_upstream(svc)
    if ":" not in upstream:
        raise AtaError("--upstream must be host:port")
    up_host, up_port_s = upstream.rsplit(":", 1)
    try:
        up_port = int(up_port_s)
    except ValueError as exc:
        raise AtaError("--upstream must be host:port") from exc
    gw_cfg = cfg.get("gateway", {})
    max_body = int(gw_cfg.get("max_body_mb", 2)) * 1024 * 1024
    max_conc = int(gw_cfg.get("max_concurrent", 4))
    allow_mgmt = bool(gw_cfg.get("allow_model_management", False))
    log_name = "ollama-gateway.jsonl" if service == "ollama" else f"{service}-gateway.jsonl"
    log_path = logs_dir() / log_name
    ensure_dir(log_path.parent, 0o700)

    try:
        server = GatewayServer(
            ("127.0.0.1", listen_port),
            upstream_host=up_host,
            upstream_port=up_port,
            api_key=key,
            max_body_bytes=max_body,
            max_concurrent=max_conc,
            allow_model_management=allow_mgmt,
            log_path=log_path,
        )
    except OSError as exc:
        raise AtaError(f"could not bind 127.0.0.1:{listen_port}: {exc}") from exc
    info(f"Ollama gateway on http://127.0.0.1:{listen_port} -> http://{up_host}:{up_port}")
    stop = threading.Event()

    def _shutdown(signum: int, frame: Any) -> None:
        stop.set()
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal_handlers = {}
    with contextlib.suppress(Exception):
        signal_handlers[signal.SIGTERM] = signal.signal(signal.SIGTERM, _shutdown)
        signal_handlers[signal.SIGINT] = signal.signal(signal.SIGINT, _shutdown)
    try:
        server.serve_forever(poll_interval=0.5)
    finally:
        with contextlib.suppress(Exception):
            server.server_close()
        for sig, handler in signal_handlers.items():
            with contextlib.suppress(Exception):
                signal.signal(sig, handler)
    return 0


