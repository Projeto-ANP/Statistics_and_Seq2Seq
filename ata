def cmd_version(args: argparse.Namespace) -> int:
    print(f"{APP} {VERSION}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=APP,
        description="Private remote access through zrok2 private share, without root or open ports.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            f"  {APP} init\n"
            f"  {APP} up\n"
            f"  {APP} status\n"
            f"  {APP} doctor\n"
            f"  {APP} export --file bundle.json\n"
            f"  {APP} import bundle.json\n"
            f"  {APP} down\n"
        ),
    )
    parser.add_argument("--home", help="alternative base directory (same as ATA_HOME)")
    parser.add_argument("--config", help="alternative path to config.json")
    parser.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p_init = sub.add_parser("init", help="configure this machine")
    p_init.add_argument("--role", choices=["server", "client"])
    p_init.add_argument("--prefix")
    p_init.add_argument("--account-token")
    p_init.add_argument("--bundle")
    p_init.add_argument("--non-interactive", action="store_true")
    p_init.add_argument("--no-activate", action="store_true")
    p_init.add_argument("--force", action="store_true")
    p_init.add_argument("--ollama-port", type=int)
    p_init.add_argument("--ollama2-port", type=int, help="server: local port of the second Ollama (e.g. 11435)")
    p_init.add_argument("--ollama2-client-port", type=int, help="client: local port for the second Ollama")
    p_init.add_argument("--ollama-label", help="label for the first Ollama (e.g. GPU 1)")
    p_init.add_argument("--ollama2-label", help="label for the second Ollama (e.g. GPU 0)")
    p_init.add_argument("--code-port", type=int)
    p_init.add_argument("--ssh-port", type=int)
    p_init.set_defaults(func=cmd_init)

    p_up = sub.add_parser("up", help="start the gateway and shares/accesses")
    p_up.add_argument("--supervisor", choices=["auto", "systemd", "nohup"])
    p_up.add_argument("--quiet", action="store_true")
    p_up.set_defaults(func=cmd_up)

    p_down = sub.add_parser("down", help="stop everything")
    p_down.add_argument("--quiet", action="store_true")
    p_down.set_defaults(func=cmd_down)

    p_restart = sub.add_parser("restart", help="restart everything")
    p_restart.add_argument("--supervisor", choices=["auto", "systemd", "nohup"])
    p_restart.add_argument("--quiet", action="store_true")
    p_restart.set_defaults(func=cmd_restart)

    p_status = sub.add_parser("status", help="show status")
    p_status.add_argument("--json", action="store_true")
    p_status.set_defaults(func=cmd_status)

    p_doctor = sub.add_parser("doctor", help="diagnose network, ports, and security")
    p_doctor.set_defaults(func=cmd_doctor)

    p_logs = sub.add_parser("logs", help="show logs")
    p_logs.add_argument("service", nargs="?")
    p_logs.add_argument("-f", "--follow", action="store_true")
    p_logs.add_argument("-n", "--lines", type=int, default=200)
    p_logs.set_defaults(func=cmd_logs)

    p_key = sub.add_parser("key", help="show or rotate the Ollama key")
    key_sub = p_key.add_subparsers(dest="key_command", required=True)
    p_key_show = key_sub.add_parser("show", help="show the current key")
    p_key_show.add_argument("--service", help="Ollama service name (e.g. ollama, ollama2)")
    p_key_rotate = key_sub.add_parser("rotate", help="generate a new key and restart the gateway")
    p_key_rotate.add_argument("--service", help="Ollama service name (e.g. ollama, ollama2)")
    p_key.set_defaults(func=cmd_key)

    p_export = sub.add_parser("export", help="generate the client bundle (contains a secret)")
    p_export.add_argument("--file")
    p_export.set_defaults(func=cmd_export)

    p_import = sub.add_parser("import", help="import the server bundle")
    p_import.add_argument("bundle")
    p_import.add_argument("--activate", action="store_true")
    p_import.set_defaults(func=cmd_import)

    p_env = sub.add_parser("env", help="print Ollama/OpenAI environment variables on the client")
    p_env.add_argument("--service", help="Ollama service name (e.g. ollama, ollama2)")
    p_env.set_defaults(func=cmd_env)

    p_ssh = sub.add_parser("ssh", help="print the SSH command/config on the client")
    p_ssh.add_argument("--config", dest="ssh_config", action="store_true")
    p_ssh.add_argument("--user")
    p_ssh.set_defaults(func=cmd_ssh)

    p_gw = sub.add_parser("gateway", help="(internal) local Ollama gateway")
    p_gw.add_argument("--service", default="ollama")
    p_gw.add_argument("--listen-port", type=int)
    p_gw.add_argument("--upstream")
    p_gw.set_defaults(func=cmd_gateway)

    p_un = sub.add_parser("uninstall", help="remove services (and optionally data)")
    p_un.add_argument("--purge", action="store_true")
    p_un.add_argument("--purge-zrok", action="store_true")
    p_un.add_argument("--delete-shares", action="store_true")
    p_un.add_argument("--yes", action="store_true")
    p_un.set_defaults(func=cmd_uninstall)

    return parser


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.home:
        os.environ["ATA_HOME"] = str(Path(args.home).expanduser())
    if args.config:
        os.environ["ATA_CONFIG"] = str(Path(args.config).expanduser())
    try:
        return int(args.func(args))
    except AtaError as exc:
        error(str(exc))
        return 1
    except OSError as exc:
        error(f"file/system operation failed: {exc}")
        return 1
    except KeyboardInterrupt:
        eprint("")
        warn("interrupted")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
