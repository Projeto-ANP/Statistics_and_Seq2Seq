def cmd_init(args: argparse.Namespace) -> int:
    existing = config_path().exists()
    if existing and not args.force:
        cfg = load_config()
        info(f"configuration already exists at {config_path()} (role={cfg.get('role')})")
        info("use --force to reconfigure")
        return 0

    role = args.role
    if not role:
        if args.non_interactive:
            raise AtaError("--role is required with --non-interactive")
        eprint("")
        eprint("This script has two roles:")
        eprint("  server = the remote machine (no root) that will be accessed")
        eprint("  client = your laptop/PC that will access it")
        role = "server" if ask_bool("Is this machine the remote server?", True) else "client"

    prefix = args.prefix or (default_prefix() if args.non_interactive else sanitize_prefix(ask_text("Share prefix", default_prefix())))
    prefix = sanitize_prefix(prefix)

    account_token = args.account_token or os.environ.get("ZROK_ACCOUNT_TOKEN", "").strip()
    zrok_ready = False
    with contextlib.suppress(Exception):
        zrok_ready = zrok_bin().exists() and zrok_env_enabled()

    if not zrok_ready and not account_token and not args.non_interactive:
        eprint("")
        eprint("Free account: https://myzrok.io")
        eprint("Dashboard -> 'CLICK HERE TO GET STARTED' -> copy the account token.")
        account_token = ask_text(
            "zrok account token (leave empty to activate later)",
            secret=True,
            allow_empty=True,
        )

    cfg = default_config(role, prefix)

    if role == "server":
        if not args.non_interactive:
            eprint("")
            eprint("Which services should be exposed? (all use a private share)")
            cfg["services"]["ollama"]["enabled"] = ask_bool("Ollama API?", True)
            cfg["services"]["code"]["enabled"] = ask_bool("code-server?", True)
            cfg["services"]["ssh"]["enabled"] = ask_bool("SSH?", True)
            cfg["services"]["guacamole"]["enabled"] = ask_bool("Guacamole web (optional)?", False)
        if args.ollama_port:
            cfg["services"]["ollama"]["upstream_port"] = args.ollama_port
        if args.code_port:
            cfg["services"]["code"]["upstream_port"] = args.code_port
        if args.ssh_port:
            cfg["services"]["ssh"]["upstream_port"] = args.ssh_port
        if not args.non_interactive:
            cfg["services"]["ollama"]["upstream_port"] = ask_int(
                "Local Ollama port", cfg["services"]["ollama"]["upstream_port"]
            )
            cfg["services"]["code"]["upstream_port"] = ask_int(
                "Local code-server port", cfg["services"]["code"]["upstream_port"]
            )
            cfg["services"]["ssh"]["upstream_port"] = ask_int(
                "Local SSH port", cfg["services"]["ssh"]["upstream_port"]
            )
        cfg["services"]["guacamole"]["upstream_port"] = cfg["services"]["code"]["upstream_port"] + 1

        second_default = port_open("127.0.0.1", 11435)
        second = bool(args.ollama2_port) or (
            not args.non_interactive
            and cfg["services"]["ollama"]["enabled"]
            and ask_bool("Is there a second Ollama instance (another GPU)?", second_default)
        )
        if second and not cfg["services"]["ollama"]["enabled"]:
            warn("second Ollama requested, but the first Ollama is disabled; ignoring it")
            second = False
        if second:
            port2 = args.ollama2_port or (
                ask_int("Local port for the second Ollama", 11435)
                if not args.non_interactive
                else 11435
            )
            if port2 == int(cfg["services"]["ollama"]["upstream_port"]):
                warn("the second Ollama port is the same as the first; check your configuration")
            label1 = args.ollama_label or (
                ask_text("Label for Ollama on port %d" % cfg["services"]["ollama"]["upstream_port"], "GPU 1")
                if not args.non_interactive
                else "GPU 1"
            )
            label2 = args.ollama2_label or (
                ask_text("Label for the second Ollama on port %d" % port2, "GPU 0")
                if not args.non_interactive
                else "GPU 0"
            )
            cfg["services"]["ollama"]["label"] = label1
            cfg["services"]["ollama"]["env_prefix"] = "OLLAMA_GPU1"
            cfg["services"]["ollama2"] = make_ollama_service(
                prefix, "ollama2", port2, 18081, 18081, label2, "OLLAMA_GPU0"
            )
        else:
            cfg["services"]["ollama"]["label"] = "Ollama"
            cfg["services"]["ollama"]["env_prefix"] = "OLLAMA"

        for service, svc in ollama_services(cfg):
            path = ollama_key_file(cfg, service)
            if path.exists():
                ensure_secure_file(path)
                info(f"keeping existing key for '{service}' at {path}")
            else:
                generate_ollama_key(cfg, service)
                ok(f"key for '{service}' generated at {path} (mode 0600)")
    else:
        bundle_path = args.bundle
        if bundle_path:
            bundle = load_bundle(Path(bundle_path))
            apply_bundle(cfg, bundle)
        else:
            if not args.non_interactive:
                eprint("")
                eprint("Use the same services/prefix configured on the server.")
                cfg["services"]["ollama"]["enabled"] = ask_bool("Access Ollama?", True)
                cfg["services"]["code"]["enabled"] = ask_bool("Access code-server?", True)
                cfg["services"]["ssh"]["enabled"] = ask_bool("Access SSH?", True)
                cfg["services"]["guacamole"]["enabled"] = ask_bool("Access Guacamole?", False)
                second = bool(args.ollama2_client_port) or (
                    cfg["services"]["ollama"]["enabled"]
                    and ask_bool("Access a second Ollama instance (another GPU)?", False)
                )
                if second and not cfg["services"]["ollama"]["enabled"]:
                    warn("second Ollama requested, but the first Ollama is disabled; ignoring it")
                    second = False
                if second:
                    port1 = ask_int(
                        "Local port for the first Ollama",
                        cfg["services"]["ollama"]["client_port"],
                    )
                    cfg["services"]["ollama"]["client_port"] = port1
                    label1 = args.ollama_label or ask_text("Label for the first Ollama", "GPU 1")
                    label2 = args.ollama2_label or ask_text("Label for the second Ollama", "GPU 0")
                    port2 = args.ollama2_client_port or ask_int("Local port for the second Ollama", 18081)
                    if port2 == port1:
                        warn("the second Ollama client port is the same as the first; check your configuration")
                    cfg["services"]["ollama"]["label"] = label1
                    cfg["services"]["ollama"]["env_prefix"] = "OLLAMA_GPU1"
                    cfg["services"]["ollama2"] = make_ollama_service(
                        prefix, "ollama2", 0, port2, port2, label2, "OLLAMA_GPU0"
                    )
                else:
                    cfg["services"]["ollama"]["label"] = "Ollama"
                    cfg["services"]["ollama"]["env_prefix"] = "OLLAMA"
                for service, svc in ollama_services(cfg):
                    key = ask_text(
                        f"API key for {service_label(service, svc)} (same as the server; leave empty to import later)",
                        secret=True,
                        allow_empty=True,
                    )
                    if key:
                        path = ollama_key_file(cfg, service)
                        atomic_write(path, key.strip() + "\n", 0o600)
                        cfg.setdefault("secrets", {}).setdefault("ollama_keys", {})[service] = str(path)
                        if service == "ollama":
                            cfg["secrets"]["ollama_key_file"] = str(path)
                cfg["services"]["code"]["client_port"] = ask_int(
                    "Local port for code-server", cfg["services"]["code"]["client_port"]
                )
                cfg["services"]["ssh"]["client_port"] = ask_int(
                    "Local port for SSH", cfg["services"]["ssh"]["client_port"]
                )
            if (
                args.non_interactive
                and args.ollama2_client_port
                and cfg["services"]["ollama"]["enabled"]
            ):
                cfg["services"]["ollama"]["label"] = args.ollama_label or "GPU 1"
                cfg["services"]["ollama"]["env_prefix"] = "OLLAMA_GPU1"
                cfg["services"]["ollama2"] = make_ollama_service(
                    prefix,
                    "ollama2",
                    0,
                    args.ollama2_client_port,
                    args.ollama2_client_port,
                    args.ollama2_label or "GPU 0",
                    "OLLAMA_GPU0",
                )
            for name, svc in cfg["services"].items():
                svc["share"] = share_name(prefix, name)

    save_config(cfg)
    ok(f"configuration saved to {config_path()}")
    if role == "client":
        for service, svc in ollama_services(cfg):
            client_key = ollama_key_file(cfg, service)
            if not client_key.exists():
                warn(
                    f"key for '{service}' missing at {client_key}; "
                    "import the server bundle or set it later"
                )

    if account_token and not args.no_activate:
        try:
            ensure_zrok2(cfg)
            ensure_zrok_enabled(account_token)
        except AtaError as exc:
            warn(str(exc))
            warn("configuration was saved; run 'ata up' when the network allows it")
    elif not zrok_ready:
        warn("zrok environment is not enabled yet; 'ata up' will ask for the account token")

    eprint("")
    if role == "server":
        info("next step: ./ata up")
        info("then: ./ata export > bundle.json  (contains the Ollama key(s); transfer it securely)")
    else:
        info("next step: ./ata up")
        info("if you have not imported the bundle yet: ./ata import bundle.json")
    return 0


def cmd_up(args: argparse.Namespace) -> int:
    cfg = load_config()
    ensure_zrok2(cfg)
    if args.quiet and not zrok_env_enabled():
        raise AtaError("zrok environment is not enabled; run 'ata up' interactively once")
    ensure_zrok_enabled(None)

    supervisor = (
        args.supervisor
        or cfg.get("runtime", {}).get("active_supervisor")
        or cfg.get("runtime", {}).get("supervisor")
        or "auto"
    )
    supervisor = choose_supervisor(supervisor)
    cfg["runtime"]["active_supervisor"] = supervisor
    save_config(cfg)

    if cfg["role"] == "server":
        for service, _svc in ollama_services(cfg):
            read_ollama_key(cfg, service)
        for name, svc in cfg_services(cfg):
            ensure_share(str(svc["share"]), service_backend_mode(svc))
        specs = server_specs(cfg)
    else:
        for service, _svc in ollama_services(cfg):
            key_file = ollama_key_file(cfg, service)
            if not key_file.exists():
                warn(f"key for '{service}' missing at {key_file}; import the server bundle")
        available = set()
        for name, svc in cfg_services(cfg):
            if zrok_share_exists(str(svc["share"])):
                available.add(name)
            else:
                warn(f"share '{svc['share']}' does not exist yet; the server must be running 'ata up'")
        specs = [
            spec for spec in client_specs(cfg)
            if any(spec.key.endswith(f"-{name}") for name in available)
        ]
        if not specs:
            raise AtaError("no shares are available; start 'ata up' on the server first")

    try:
        start_specs(specs, supervisor)
    except Exception:
        stop_specs(specs)
        raise

    if cfg["role"] == "server":
        for service, _svc in ollama_services(cfg):
            if not wait_gateway(cfg, service, timeout=15):
                stop_specs(specs)
                hint = "gateway" if service == "ollama" else f"gateway-{service}"
                raise AtaError(f"gateway '{service}' did not start; see 'ata logs {hint}'")
    if cfg["role"] == "client":
        wait_client_ports(cfg, timeout=20, only=available)

    if supervisor == "nohup":
        cron_install_autostart()

    if not args.quiet:
        eprint("")
        cmd_status(argparse.Namespace(json=False))
    return 0


def cmd_down(args: argparse.Namespace) -> int:
    cfg = load_config()
    specs = server_specs(cfg) + client_specs(cfg)
    stop_specs(specs)
    cron_remove_autostart()
    if not args.quiet:
        ok("services stopped")
    return 0


def cmd_restart(args: argparse.Namespace) -> int:
    cmd_down(argparse.Namespace(quiet=True))
    time.sleep(1.0)
    return cmd_up(args)


def wait_gateway(cfg: Dict[str, Any], service: str = "ollama", timeout: int = 15) -> bool:
    port = gateway_port(cfg, service)
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            status, body, _ = http_get(f"http://127.0.0.1:{port}/healthz", timeout=2)
            if status == 200 and b'"service": "ata-gateway"' in body:
                return True
        except Exception:
            pass
        time.sleep(0.4)
    hint = "gateway" if service == "ollama" else f"gateway-{service}"
    warn(f"gateway '{service}' has not responded yet; see: ata logs {hint}")
    return False


def wait_client_ports(cfg: Dict[str, Any], timeout: int = 20, only: Optional[set] = None) -> bool:
    deadline = time.time() + timeout
    pending = [
        (n, service_client_port(s))
        for n, s in cfg_services(cfg)
        if only is None or n in only
    ]
    ok_all = False
    while time.time() < deadline:
        remaining = []
        for name, port in pending:
            try:
                with socket.create_connection(("127.0.0.1", port), timeout=0.7):
                    pass
            except OSError:
                remaining.append((name, port))
        pending = remaining
        if not pending:
            ok_all = True
            break
        time.sleep(0.5)
    if not ok_all:
        names = ", ".join(f"{n}:{p}" for n, p in pending)
        warn(f"local ports have not opened yet: {names}; see: ata logs <service>")
    return ok_all


def http_get(url: str, headers: Optional[Dict[str, str]] = None, timeout: int = 10) -> Tuple[int, bytes, Dict[str, str]]:
    req = urllib.request.Request(url, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, resp.read(65536), dict(resp.headers)
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read(65536), dict(exc.headers)


def port_open(host: str, port: int, timeout: float = 1.0) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def listening_ports() -> List[str]:
    if not shutil.which("ss"):
        return []
    proc = run_cmd(["ss", "-ltn"], timeout=10)
    if proc.returncode != 0:
        return []
    lines = proc.stdout.splitlines()[1:]
    return [ln.strip() for ln in lines if ln.strip()]


def cmd_status(args: argparse.Namespace) -> int:
    cfg = load_config()
    supervisor = cfg.get("runtime", {}).get("active_supervisor") or cfg.get("runtime", {}).get("supervisor", "auto")
    if supervisor == "auto":
        supervisor = "systemd" if systemd_available() else "nohup"
    specs = server_specs(cfg) + client_specs(cfg)
    env_ok = zrok_bin().exists() and zrok_env_enabled()
    gateways: Dict[str, Any] = {}
    if cfg["role"] == "server":
        for service, _svc in ollama_services(cfg):
            port = gateway_port(cfg, service)
            gw_ok = False
            with contextlib.suppress(Exception):
                status, body, _ = http_get(f"http://127.0.0.1:{port}/healthz", timeout=2)
                gw_ok = status == 200 and b'"service": "ata-gateway"' in body
            gateways[service] = {"port": port, "ok": gw_ok}

    data: Dict[str, Any] = {
        "role": cfg["role"],
        "prefix": cfg["prefix"],
        "config": str(config_path()),
        "supervisor": supervisor,
        "zrok_environment": env_ok,
        "gateways": gateways,
        "services": {},
        "processes": {},
    }
    for spec in specs:
        running = spec_running(spec, supervisor) if supervisor != "auto" else (systemd_active(spec) or pid_matches(spec, read_pid(spec)))
        data["processes"][spec.key] = running
    for name, svc in cfg_services(cfg):
        if cfg["role"] == "server":
            data["services"][name] = {
                "enabled": True,
                "kind": svc.get("kind"),
                "upstream": service_upstream(svc),
                "share": svc["share"],
                "target": service_target(svc),
                "upstream_open": port_open(svc.get("upstream_host", "127.0.0.1"), int(svc["upstream_port"])),
                "process": f"server-share-{name}",
            }
        else:
            data["services"][name] = {
                "enabled": True,
                "kind": svc.get("kind"),
                "share": svc["share"],
                "local_port": service_client_port(svc),
                "local_open": port_open("127.0.0.1", service_client_port(svc)),
                "process": f"client-access-{name}",
            }
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0

    print("")
    print(f"  role        : {data['role']}")
    print(f"  prefix      : {data['prefix']}")
    print(f"  config      : {data['config']}")
    print(f"  supervisor  : {data['supervisor']}")
    print(f"  zrok2       : {'environment active' if env_ok else 'environment NOT enabled'}")
    for service, info in gateways.items():
        label = service_label(service, cfg["services"][service])
        state = "ok" if info["ok"] else "no response"
        print(f"  gateway {label:<18}: {state} (http://127.0.0.1:{info['port']}/healthz)")
    print("")
    for name, svc in cfg_services(cfg):
        proc = f"{'server-share' if cfg['role'] == 'server' else 'client-access'}-{name}"
        running = data["processes"].get(proc, False)
        label = service_label(name, svc)
        if cfg["role"] == "server":
            up = "ok" if data["services"][name]["upstream_open"] else "closed"
            gateway_info = ""
            if name in gateways:
                gateway_info = f"  gateway=127.0.0.1:{gateways[name]['port']}"
            print(
                f"  {label:<18} {'UP' if running else 'DOWN':<5}  "
                f"share={svc['share']}  upstream={service_upstream(svc)} ({up}){gateway_info}"
            )
        else:
            local = "ok" if data["services"][name]["local_open"] else "closed"
            if name == "ssh":
                url = f"ssh -p {service_client_port(svc)} {getpass.getuser()}@127.0.0.1"
            elif svc.get("auth") == "bearer":
                url = f"http://127.0.0.1:{service_client_port(svc)}  (API: /v1)"
            else:
                url = f"http://127.0.0.1:{service_client_port(svc)}"
            print(f"  {label:<18} {'UP' if running else 'DOWN':<5}  {url}  [{local}]")
    if cfg["role"] == "server":
        print("")
        print(f"  client bundle: {script_path()} export --file bundle.json")
    else:
        print("")
        print(f"  Ollama env: {script_path()} env")
        print(f"  ssh: {script_path()} ssh")
    print("")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    cfg = load_config(required=False)
    failures = 0
    warns = 0

    def report(ok_flag: bool, label: str, detail: str = "", warning: bool = False) -> None:
        nonlocal failures, warns
        if ok_flag:
            ok(label + (f" - {detail}" if detail else ""))
        elif warning:
            warn(label + (f" - {detail}" if detail else ""))
            warns += 1
        else:
            error(label + (f" - {detail}" if detail else ""))
            failures += 1

    report(sys.version_info >= (3, 8), "Python >= 3.8", platform.python_version())
    report(config_path().exists(), "configuration exists", str(config_path()))
    if not config_path().exists():
        return 1

    report(cfg.get("role") in ("server", "client"), "valid role", str(cfg.get("role")))
    report(zrok_bin().exists(), "zrok2 installed", str(zrok_bin()), warning=True)
    if zrok_bin().exists():
        proc = run_cmd([str(zrok_bin()), "version"], timeout=20)
        report(proc.returncode == 0, "zrok2 runs", strip_ansi(proc.stdout).strip().splitlines()[-1] if proc.stdout else "")
        report(zrok_env_enabled(), "zrok environment enabled", warning=True)
    try:
        status, _, _ = http_get(ZROK_API_URL, timeout=8)
        report(200 <= status < 500, "api-v2.zrok.io reachable", f"HTTP {status}")
    except Exception as exc:
        report(False, "api-v2.zrok.io reachable", str(exc)[:120])

    if cfg["role"] == "server":
        for name, svc in cfg_services(cfg):
            host = svc.get("upstream_host", "127.0.0.1")
            port = int(svc["upstream_port"])
            report(port_open(host, port), f"{service_label(name, svc)} upstream {host}:{port}", warning=True)
        for service, svc in ollama_services(cfg):
            label = service_label(service, svc)
            port = gateway_port(cfg, service)
            try:
                status, body, _ = http_get(f"http://127.0.0.1:{port}/healthz", timeout=3)
                healthy = status == 200 and b'"service": "ata-gateway"' in body
                report(healthy, f"{label} gateway responds", f"HTTP {status}", warning=True)
            except Exception:
                report(False, f"{label} gateway responds", warning=True)
            try:
                key = read_ollama_key(cfg, service)
                status, _, _ = http_get(f"http://127.0.0.1:{port}/api/tags", timeout=5)
                report(status == 401, f"{label} gateway requires a key without Authorization", f"HTTP {status}")
                status, _, _ = http_get(
                    f"http://127.0.0.1:{port}/api/tags",
                    headers={"Authorization": f"Bearer {key}"},
                    timeout=10,
                )
                report(status == 200, f"{label} gateway accepts the key", f"HTTP {status}")
                status, _, _ = http_get(
                    f"http://127.0.0.1:{port}/api/delete",
                    headers={"Authorization": f"Bearer {key}"},
                    timeout=5,
                )
                report(status == 404, f"{label} gateway blocks /api/delete", f"HTTP {status}")
            except Exception as exc:
                report(False, f"{label} gateway authentication test", str(exc)[:120], warning=True)
    else:
        for name, svc in cfg_services(cfg):
            port = service_client_port(svc)
            report(
                port_open("127.0.0.1", port),
                f"{service_label(name, svc)} local 127.0.0.1:{port}",
                warning=True,
            )
            if not zrok_share_exists(str(svc["share"])):
                report(False, f"share {svc['share']} visible", "server may be down", warning=True)
        for service, svc in ollama_services(cfg):
            key_path_obj = ollama_key_file(cfg, service)
            report(key_path_obj.exists(), f"key for '{service}' on the client", str(key_path_obj), warning=True)

    # Permissions
    key_files = [ollama_key_file(cfg, service) for service, _svc in ollama_services(cfg)]
    for p, mode in [(config_path(), 0o600)] + [(p, 0o600) for p in key_files]:
        if p.exists():
            actual = p.stat().st_mode & 0o777
            report(actual <= mode, f"permission {oct(actual)} on {p.name}", warning=True)

    # Public ports (not caused by ata, but worth checking).
    public = []
    for line in listening_ports():
        if "0.0.0.0:" in line or "[::]:" in line or " *:" in line:
            public.append(line)
    if not shutil.which("ss"):
        report(False, "listening-port check", "ss not available on this OS", warning=True)
    elif public:
        report(False, "ports listening on all interfaces", f"{len(public)} found; review with ss -ltnp", warning=True)
    else:
        report(True, "no TCP port on 0.0.0.0/::")

    if systemd_available():
        linger = linger_enabled()
        report(linger is True, "systemd linger", "services survive logout", warning=True)

    print("")
    if failures:
        error(f"doctor: {failures} failure(s), {warns} warning(s)")
        return 1
    ok(f"doctor: no failures ({warns} warning(s))")
    return 0


