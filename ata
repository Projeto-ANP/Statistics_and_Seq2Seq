def service_target_port(svc: Dict[str, Any]) -> int:
    """Local port the share should point to (gateway for Ollama; upstream otherwise)."""
    if svc.get("auth") == "bearer" and svc.get("gateway_port"):
        return int(svc["gateway_port"])
    return int(svc.get("upstream_port", 0))


def service_target(svc: Dict[str, Any]) -> str:
    """host:port the zrok share should point to."""
    if svc.get("auth") == "bearer" and svc.get("gateway_port"):
        return f"127.0.0.1:{int(svc['gateway_port'])}"
    return f"{svc.get('upstream_host', '127.0.0.1')}:{int(svc.get('upstream_port', 0))}"


def service_client_port(svc: Dict[str, Any]) -> int:
    return int(svc.get("client_port", 0))


def service_backend_mode(svc: Dict[str, Any]) -> str:
    return "tcpTunnel" if svc.get("kind") == "tcp" else "proxy"


def gateway_port(cfg: Dict[str, Any], service: str = "ollama") -> int:
    svc = cfg["services"].get(service, {})
    return int(svc.get("gateway_port", 18080))


